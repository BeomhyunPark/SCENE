# Copy to .env (chmod 600). Never commit .env.
SCENE_HOST=scene.greengroove.app
# Long random value, e.g. `openssl rand -base64 32`
SCENE_DB_PASSWORD=
# Cloudflare Zero Trust > Networks > Tunnels > (tunnel) > token
CLOUDFLARE_TUNNEL_TOKEN=
# Google sign-in (#232). Google Cloud console > APIs & Services > Credentials > OAuth client (Web).
# Authorized redirect URI: https://scene.greengroove.app/login/oauth2/code/google
SCENE_GOOGLE_CLIENT_ID=
SCENE_GOOGLE_CLIENT_SECRET=
# First admin (DEC-069): this Google email's first sign-in creates the space below, once.
SCENE_BOOTSTRAP_OWNER_EMAIL=
SCENE_BOOTSTRAP_SPACE_NAME=지구촌교회 드림공동체 청년2부
# Check-in QR signing (DEC-071), e.g. `openssl rand -base64 32`. Do not change it during an event:
# every QR already shown stops working. Empty means QR check-in is off.
SCENE_CHECKIN_CODE_SECRET=
# Backup (backup.sh): rclone remote and folder, and the age public key (age1...).
# The matching private key stays off this machine.
BACKUP_REMOTE=r2:retreat-db-backups/scene
BACKUP_AGE_RECIPIENT=
BACKUP_KEEP_DAYS=30
