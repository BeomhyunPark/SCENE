# Copy to .env (chmod 600). Never commit .env.
SCENE_HOST=scene.greengroove.app
# Long random value, e.g. `openssl rand -base64 32`
SCENE_DB_PASSWORD=
# Cloudflare Zero Trust > Networks > Tunnels > (tunnel) > token
CLOUDFLARE_TUNNEL_TOKEN=
# Google sign-in (#232). Google Cloud console > APIs & Services > Credentials > OAuth client (Web).
# Authorized redirect URI: https://scene.greengroove.app/login/oauth2/code/google
SCENE_GOOGLE_CLIENT_ID=
SCENE_GOOGLE_CLIENT_SECRET=
# First admin (DEC-069): this Google email's first sign-in creates the space below, once.
SCENE_BOOTSTRAP_OWNER_EMAIL=
SCENE_BOOTSTRAP_SPACE_NAME=지구촌교회 드림공동체 청년2부
# Check-in QR signing (DEC-071), e.g. `openssl rand -base64 32`. Do not change it during an event:
# every QR already shown stops working. Required: the stack does not start without it (#519).
SCENE_CHECKIN_CODE_SECRET=
# Invitation mail (#470). Empty or false: operators copy the invitation link once and pass it on.
# true: the link is mailed to the invited address. Any SMTP account works. Gmail: host
# smtp.gmail.com, port 587, username = the Gmail address, password = a 16-letter app password
# (Google account > Security > 2-Step Verification > App passwords), FROM like
# SCENE <that.address@gmail.com>. Gmail sends about 500 mails a day. Then `docker compose up -d backend`.
SCENE_MAIL_ENABLED=
SCENE_MAIL_HOST=
SCENE_MAIL_PORT=587
SCENE_MAIL_USERNAME=
SCENE_MAIL_PASSWORD=
SCENE_MAIL_FROM=
# Participant limits (DEC-078, #401). Empty keeps the default. Durations like 5m, 10m.
# Defaults: 5 wrong numbers in a row lock one phone; the 1st, 2nd and 3rd lock inside 24h last
# 5m, 30m, 24h (LOCKDURATIONS=5m,30m,24h). 300 failed sign-ins and 1000 public submits per
# address per 10m. Raise them on site if people behind one Wi-Fi get 429, then run
# `docker compose up -d backend` (no deploy needed).
SCENE_PARTICIPANT_LOCKFAILURES=
SCENE_PARTICIPANT_LOCKDURATIONS=
SCENE_PARTICIPANT_LOCKESCALATIONWINDOW=
SCENE_PARTICIPANT_IPFAILURELIMIT=
SCENE_PARTICIPANT_IPFAILUREWINDOW=
SCENE_PARTICIPANT_SUBMITIPLIMIT=
SCENE_PARTICIPANT_SUBMITIPWINDOW=
# Participant screen refresh interval in seconds (DEC-080, #423). 10-300, empty keeps 25 (±20% on screen = 20-30 s).
# Raise it if the server is slow during the retreat, then `docker compose up -d backend`.
SCENE_PARTICIPANT_POLLAFTERSECONDS=
# Operator screen refresh interval in seconds (DEC-080, #436): notification badge and list.
# 10-300, empty keeps 15. Same restart as above.
SCENE_OPERATOR_POLLAFTERSECONDS=
# Backup (backup.sh): rclone remote and folder, and the age public key (age1...).
# The matching private key stays off this machine.
BACKUP_REMOTE=r2:retreat-db-backups/scene
BACKUP_AGE_RECIPIENT=
BACKUP_KEEP_DAYS=30
# Alerts (deploy/home/notify.sh, docs/devops/home-server.md §8). All optional: empty sends nothing.
# One webhook for deploy/backup/reboot alerts: ntfy topic URL, Discord or Slack webhook, or
# https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>. It holds a secret: keep it here only.
SCENE_ALERT_URL=
# Heartbeats (e.g. healthchecks.io ping URLs): pinged after every auto-deploy run / every good backup.
SCENE_DEPLOY_HEARTBEAT_URL=
BACKUP_HEARTBEAT_URL=
