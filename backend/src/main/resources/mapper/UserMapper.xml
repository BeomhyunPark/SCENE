<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="app.scene.identity.mapper.UserMapper">

  <sql id="columns">
    id, display_name
  </sql>

  <select id="findById" resultType="app.scene.identity.OperatorAccount">
    SELECT <include refid="columns"/>
    FROM users
    WHERE id = #{id}
  </select>

</mapper>
